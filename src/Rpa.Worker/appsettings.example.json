{
  "ConnectionStrings": {
    "RpaDatabase": ""
  },
  "RpaWorker": {
    "Enabled": false,
    "ExecutionMode": "SafeValidation",
    "WorkerId": "worker-local-01",
    "WorkspaceRoot": "../..",
    "PollIntervalSeconds": 5,
    "MaxParallelism": 2,
    "LeaseSeconds": 300,
    "HeartbeatSeconds": 60,
    "CaseTimeoutMinutes": 30,
    "RetryDelaySeconds": 60,
    "OperationalHeartbeatSeconds": 30,
    "GlobalExecutionLockName": "Rpa.Worker.PollingGlobal",
    "Storage": {
      "ArtifactRoot": "storage/artifacts",
      "SessionStateRoot": "storage/sessions"
    },
    "Tables": {
      "Schema": "rpa",
      "WorkItems": "WorkItem",
      "Executions": "Execution",
      "Outputs": "ExecutionOutput",
      "Artifacts": "Artifact",
      "Events": "ExecutionEvent",
      "Workers": "WorkerState"
    },
    "EmailReader": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "RequestTimeoutSeconds": 30,
      "Providers": {
        "email-otp": {
          "Enabled": false,
          "Provider": "MicrosoftGraph",
          "Mailbox": "rpa@example.com",
          "SenderAddress": "no-reply@example.com",
          "SubjectContains": "Código de autenticação",
          "CodePattern": "(?:código|token)\\s*(?:de acesso)?\\s*[-:]\\s*(\\d{6})",
          "MaximumEmailAgeMinutes": 5,
          "RequestedEmailCount": 10
        }
      }
    },
    "Definitions": {
      "exemplo": {
        "Enabled": true,
        "ClaimEnabled": false,
        "Package": {
          "RpaId": "rpa-exemplo",
          "OriginName": "source",
          "Provider": "File",
          "Location": "examples/RpaExemplo/package-store"
        },
        "ConfigurationFile": "examples/RpaExemplo/appsettings.example.json",
        "Runtime": {
          "Headless": true,
          "Browser": "cloakbrowser",
          "ActionTimeoutSeconds": 30,
          "UploadTimeoutSeconds": 90,
          "ReadinessQuietPeriodMs": 800,
          "FormStabilityMs": 600,
          "Locale": "pt-BR",
          "ViewportWidth": 1440,
          "ViewportHeight": 1000,
          "BusySelectors": [
            "[aria-busy='true']",
            "[data-loading='true']",
            ".loading",
            ".spinner"
          ],
          "UseSessionState": false,
          "SaveSessionState": false,
          "MaximumArtifactBytes": 52428800,
          "MaximumArtifactFilesPerExecution": 100,
          "ArtifactRetentionDays": 30
        },
        "SafeValidationBoundaryActionId": null,
        "IrreversibleActionIds": [],
        "AuthenticationAttemptActionIds": [],
        "AuthenticationFailureActionIds": [],
        "MfaAttemptActionIds": [],
        "MfaFailureActionIds": [],
        "Outputs": [
          {
            "Name": "estado",
            "Source": "runtime.estado",
            "Required": true,
            "Sensitive": false
          }
        ],
        "Artifacts": []
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
