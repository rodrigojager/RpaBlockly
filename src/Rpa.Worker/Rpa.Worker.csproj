<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Rpa.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.9" />
    <PackageReference Include="Microsoft.Graph" Version="5.97.0" />
    <ProjectReference Include="..\RpaFlow.Contracts\RpaFlow.Contracts.csproj" />
    <ProjectReference Include="..\RpaFlow.Runtime\RpaFlow.Runtime.csproj" />
    <ProjectReference Include="..\RpaFlow.Playwright\RpaFlow.Playwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rpa.WorkerChecks" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.local.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.local.json')" />
  </ItemGroup>
</Project>
