{
  "manifest_version": 3,
  "name": "RpaBlockly Recorder V2",
  "version": "1.0.0",
  "version_name": "1.0.0-rc.1",
  "description": "Grava interações consentidas e exporta um pacote RpaBlockly V2 revisável.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir RpaBlockly Recorder"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
