{
  "name": "@rpablockly/recorder-extension",
  "version": "1.0.0-rc.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "generate:validators": "node scripts/generate-schema-validators.mjs",
    "licenses": "node scripts/licenses.mjs",
    "lint": "node scripts/lint.mjs",
    "pretest": "npm run generate:validators",
    "pretypecheck": "npm run generate:validators",
    "recover:key": "node scripts/recover-key.mjs",
    "release": "node scripts/release.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
