<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RpaTemplate</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RpaFlow.Contracts\RpaFlow.Contracts.csproj" />
    <ProjectReference Include="..\..\src\RpaFlow.Packages\RpaFlow.Packages.csproj" />
    <ProjectReference Include="..\..\src\RpaFlow.Runtime\RpaFlow.Runtime.csproj" />
    <ProjectReference Include="..\..\src\RpaFlow.Playwright\RpaFlow.Playwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.local.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.local.json')" />
    <None Update="package-store\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="rpa.editor.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
