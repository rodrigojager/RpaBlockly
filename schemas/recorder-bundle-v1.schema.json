{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpablockly.dev/schemas/recorder-bundle-v1.schema.json",
  "title": "RpaBlocklyRecorderBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleFormat",
    "bundleVersion",
    "bundleId",
    "createdAtUtc",
    "recorderVersion",
    "generatorVersion",
    "rpaPackageRoot",
    "schemas",
    "displayName",
    "origin",
    "hasSecrets",
    "hasUploads",
    "stepCount",
    "blockingIssueCount",
    "warningIssueCount",
    "files",
    "containsReplay"
  ],
  "properties": {
    "bundleFormat": { "const": "rpablockly-recorder" },
    "bundleVersion": { "const": 1 },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "recorderVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "generatorVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "rpaPackageRoot": { "const": "package" },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "locators", "policy", "session", "evidence", "issues", "integrity"],
      "properties": {
        "flow": { "const": 2 },
        "locators": { "const": 1 },
        "policy": { "const": 1 },
        "session": { "const": 1 },
        "evidence": { "const": 1 },
        "issues": { "const": 1 },
        "integrity": { "const": 1 }
      }
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "origin": { "const": "chrome-recorder" },
    "recipientKeyId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "hasSecrets": { "type": "boolean" },
    "hasUploads": { "type": "boolean" },
    "stepCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "blockingIssueCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "warningIssueCount": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "containsReplay": { "const": false }
  }
}
