{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpablockly.local/schemas/rpa-policy-v1.schema.json",
  "title": "RpaBlockly Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locatorResilience"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locatorResilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "learningWriteBack",
        "promotion",
        "failedPrimary",
        "minimumConfidence",
        "minimumRunnerUpGap",
        "maximumCandidatesPerLocator",
        "maximumHeuristicNodes",
        "maximumResolutionMilliseconds"
      ],
      "properties": {
        "mode": { "enum": ["strict", "fallback", "adaptive"] },
        "learningWriteBack": { "enum": ["disabled", "memory", "source", "overlay"] },
        "promotion": { "enum": ["disabled", "afterSuccessfulExecution"] },
        "failedPrimary": { "enum": ["keep", "moveToLast"] },
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumRunnerUpGap": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumCandidatesPerLocator": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maximumHeuristicNodes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumResolutionMilliseconds": { "type": "integer", "minimum": 100, "maximum": 600000 }
      }
    }
  }
}
