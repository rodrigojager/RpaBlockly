{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpablockly.dev/schemas/recorder-evidence-v1.schema.json",
  "title": "RpaBlocklyRecorderEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/evidenceItem" }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "eventId",
        "actionId",
        "kind",
        "path",
        "thumbnailPath",
        "mimeType",
        "width",
        "height",
        "byteLength",
        "capturedAtUtc",
        "masks"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["before", "after"] },
        "path": { "type": "string", "pattern": "^evidence/[A-Za-z0-9._/-]+\\.webp$", "maxLength": 240 },
        "thumbnailPath": { "type": "string", "pattern": "^evidence/thumbnails/[A-Za-z0-9._/-]+\\.webp$", "maxLength": 240 },
        "mimeType": { "const": "image/webp" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 5242880 },
        "capturedAtUtc": { "type": "string", "format": "date-time" },
        "comment": { "type": "string", "maxLength": 1000 },
        "masks": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/evidenceMask" }
        }
      }
    },
    "evidenceMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "reason"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "enum": ["password", "sensitive-field", "user-region"] }
      }
    }
  }
}
