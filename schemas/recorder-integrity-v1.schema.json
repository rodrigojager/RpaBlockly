{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpablockly.dev/schemas/recorder-integrity-v1.schema.json",
  "title": "RpaBlocklyRecorderIntegrityV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/integrityEntry" }
    }
  },
  "$defs": {
    "integrityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0, "maximum": 26214400 }
      }
    }
  }
}
